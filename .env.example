# Copy to .env and fill in.

# Pokémon TCG API — optional but raises rate limits significantly.
# Get one free at https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# Where the SQLite/Postgres DB lives.
# Default sqlite path is ./data/prices.db
DATABASE_URL=sqlite:///data/prices.db

# Where trained model artifacts go.
MODEL_DIR=./models

# API server config
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
